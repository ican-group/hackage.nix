      url = "";
      synopsis = "An hledger workflow focusing on automated statement import and classification.";
      description = "hledger-flow uses hledger's CSV rules to turn each bank statement into a\nseparate journal. It combines those journals with your manual entries for\nreporting. When your rules change, you can rebuild the journals from the\noriginal statements and review which transactions changed.\nSee <https://hledger-flow.github.io/> for the quick start and tutorial.";
      buildType = "Simple";
    };
    components = {
