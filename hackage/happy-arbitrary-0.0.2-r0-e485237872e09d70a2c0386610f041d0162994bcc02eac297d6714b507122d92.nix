{ system
  , compiler
  , flags
  , pkgs
  , hsPkgs
  , pkgconfPkgs
  , errorHandler
  , config
  , ... }:
  {
    flags = {};
    package = {
      specVersion = "1.10";
      identifier = { name = "happy-arbitrary"; version = "0.0.2"; };
      license = "GPL-3.0-only";
      copyright = "Copyright (c) 2024-2026, Iphigenia Df";
      maintainer = "Iphigenia Df <iphydf@gmail.com>";
      author = "Iphigenia Df <iphydf@gmail.com>";
      homepage = "https://toktok.ltd/";
      url = "";
      synopsis = "Random programs for testing parsers made with Happy and Alex";
      description = "Makes random programs from a parser's own Happy grammar and Alex lexer, of a\ngiven size in tokens, and checks their text with the language's lexer. For\nQuickCheck properties of parsers and pretty-printers.";
      buildType = "Simple";
    };
    components = {
      "library" = {
        depends = [
          (hsPkgs."QuickCheck" or (errorHandler.buildDepError "QuickCheck"))
          (hsPkgs."aeson" or (errorHandler.buildDepError "aeson"))
          (hsPkgs."array" or (errorHandler.buildDepError "array"))
